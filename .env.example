# Application profile (set automatically by Makefile targets; do not set manually)
# APP_ENV=local|production

# PostgreSQL (used by docker compose via env_file)
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments

# Application database URLs (localhost for local development)
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
DATABASE_URL_SYNC=postgresql+psycopg://payments:payments@localhost:5432/payments

# RabbitMQ (used by docker compose via env_file)
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=payments
RABBITMQ_DEFAULT_VHOST=payments

# Application RabbitMQ URL (FastStream)
# Use localhost when running API locally; use rabbitmq hostname inside Docker.
RABBITMQ_URL=amqp://payments:payments@localhost:5672/payments

# API errors (RFC 7807)
ERROR_TYPE_BASE=https://payments.local/errors

# Logging
LOG_LEVEL=INFO

# API authentication
API_KEY=change-me-in-production

# Outbox publisher (interval/batch; enabled flag is set by APP_ENV profile)
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=10
OUTBOX_PUBLISH_MAX_ATTEMPTS=3

# RabbitMQ topology
RABBITMQ_EXCHANGE=payments
RABBITMQ_PAYMENTS_NEW_QUEUE=payments.new
RABBITMQ_PAYMENTS_NEW_DLQ=payments.new.dlq
RABBITMQ_PAYMENTS_NEW_ROUTING_KEY=payments.new

# Gateway emulation (consumer)
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9

# Webhook delivery (consumer enqueue + dispatcher)
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_DISPATCHER_POLL_INTERVAL_SECONDS=5
WEBHOOK_DISPATCHER_BATCH_SIZE=10

# Webhook security
# HMAC-SHA256 signing of outbound webhooks. Signing activates only when a
# secret is set; the secret must be at least 16 characters. Receivers verify
# the X-Webhook-Signature header (t=<timestamp>,v1=<hex hmac>).
WEBHOOK_SIGNATURE_ENABLED=true
WEBHOOK_SIGNING_SECRET=
# SSRF protection for client-supplied webhook URLs.
# Schemes/ports are JSON arrays; private/loopback/link-local hosts are blocked
# when WEBHOOK_BLOCK_PRIVATE_NETWORKS=true.
WEBHOOK_ALLOWED_SCHEMES=["https","http"]
WEBHOOK_ALLOWED_PORTS=[80,443]
WEBHOOK_BLOCK_PRIVATE_NETWORKS=true

# Consumer message processing
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_PREFETCH_COUNT=10

# OpenTelemetry (traces + metrics via OTLP)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_METRIC_EXPORT_INTERVAL_MS=10000

# Production reverse proxy (docker-compose.prod.yaml only)
NGINX_HTTP_PORT=80
